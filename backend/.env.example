# Twilio WhatsApp API Credentials
# ──────────────────────────────────
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Sandbox Number (default sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Server Configuration
PORT=3001

# Base URL for image hosting (IMPORTANT for Twilio)
# ──────────────────────────────────────────────────
# In development: Use ngrok URL (e.g., https://abc123.ngrok.io)
# In production: Use your actual server domain
BASE_URL=http://localhost:3001
