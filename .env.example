# Supabase Configuration
# ──────────────────────────────────
# Get these from your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
# ──────────────────────────────────
# The primary authorized phone number allowed to log in and generate receipts
NEXT_PUBLIC_ALLOWED_PHONE=+919898354578

# Deployment URL Configuration
# ──────────────────────────────────
# In development: use http://localhost:3000 and http://localhost:3001
# In production: update these to your public domains (e.g. Vercel / Railway domains)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Twilio WhatsApp API Credentials (Optional)
# ──────────────────────────────────
# Required only if sending receipt notifications automatically via Twilio.
# If omitted, the app defaults to direct file downloads and manual WhatsApp sharing.
# Get these from https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
